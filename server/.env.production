
# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=multi
DB_PASSWORD=Origen@tor123
DB_NAME=multi_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# SECURITY: Replace JWT_SECRET with a 64-byte random value in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=supersecretkey123
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_REFRESH_HOURS=168

# ── Redis ─────────────────────────────────────────────────────────────────────
# Explicitly set here so this file is self-contained and does not depend on
# values from .env being loaded first. The lazyConnect bug caused a startup
# race; explicit config here ensures Redis is always configured in production.
REDIS_URL=redis://default:gQAAAAAAAmD1AAIgcDIxODAyZDM5YTVkYjc0MDZlOTg1Nzc5OTYxZWUxMTFlYw@enabling-katydid-155893.upstash.io:6379
REDIS_TLS=true
REDIS_KEY_PREFIX=sm:

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4002
SERVE_FRONTEND=true
ENABLE_SPA=true

# ── Plesk / Phusion Passenger HTTP/2 compatibility ────────────────────────────
# CRITICAL: Setting KEEP_ALIVE_TIMEOUT_MS to 65000 ensures Node.js keeps
# connections open slightly longer than Nginx (which defaults to 60s).
# Setting it to 0 aggressively closes connections, which breaks Nginx HTTP/2
# multiplexing and causes ERR_HTTP2_PROTOCOL_ERROR and ERR_CONNECTION_CLOSED.
KEEP_ALIVE_TIMEOUT_MS=65000
# Give Nginx enough time to proxy requests without killing the connection
HEADERS_TIMEOUT_MS=66000
# Disable Socket.io — Passenger does not support long-lived WebSocket connections
# reliably. Enable only if using a dedicated socket server.

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://erp.multisolutionseng.com,https://serianamart.omnisuite-erp.com

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=webmail.nakdns.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@omnisuite-erp.com
SMTP_PASS=Origen@tor123
SMTP_FROM=Omnisuite ERP <admin@omnisuite-erp.com>
LICENSE_SUPER_ADMIN_ID=1

